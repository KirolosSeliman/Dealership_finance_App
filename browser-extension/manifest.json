{
  "manifest_version": 3,
  "name": "Dealer Flow Market Snap Extension",
  "version": "0.1.0",
  "description": "Analyze visible OpenLane vehicle pages with Dealer Flow Market Snap.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.vercel.app/*", "https://*.openlane.ca/*", "https://*.openlane.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Market Snap"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://*.openlane.com/*", "https://*.openlane.ca/*"],
      "js": [
        "src/storage.js",
        "src/api-client.js",
        "src/openlane-extraction-contract.js",
        "src/openlane-section-map.js",
        "src/openlane-page-classifier.js",
        "src/openlane-extractor.js",
        "src/market-snap-widget.js",
        "src/capture-runtime.js",
        "src/content-script.js"
      ],
      "css": ["styles/widget.css"],
      "run_at": "document_idle"
    }
  ]
}
