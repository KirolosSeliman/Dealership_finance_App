NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 S3-compatible backup uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Required secret for /api/backups/daily. The route will not run if this is empty.
CRON_SECRET=

# Optional Market Snap ML service URL. Required for authorized Scrapling listing extraction.
MARKET_SNAP_ML_SERVICE_URL=http://localhost:8000

# Optional comma-separated Chrome extension origins if cross-origin extension calls are enabled later.
MARKET_SNAP_EXTENSION_ORIGINS=
