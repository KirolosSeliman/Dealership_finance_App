NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production uses Supabase-backed persistent rate limiting by default.
# Use RATE_LIMIT_BACKEND=memory only for local development or tests.
RATE_LIMIT_BACKEND=supabase

# Server-only. Never expose these to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 S3-compatible backup uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Required secret for /api/backups/daily. The route will not run if this is empty.
CRON_SECRET=

# Optional Market Snap ML service URL. Required for authorized Scrapling listing extraction and scheduled source sync.
MARKET_SNAP_ML_SERVICE_URL=http://localhost:8000
MARKET_SNAP_OPENLANE_SEARCH_URLS=
MARKET_SNAP_MARKETPLACE_SEARCH_URLS=

# Required for deployed Market Snap browser-extension calls.
# Use exact installed extension origins from chrome://extensions or brave://extensions.
# Example: chrome-extension://abcdefghijklmnopabcdefghijklmnop
MARKET_SNAP_EXTENSION_ORIGINS=chrome-extension://<chrome_extension_id>,chrome-extension://<brave_extension_id>
